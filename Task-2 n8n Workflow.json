        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a skill classifier. Classify EVERY person below into exactly ONE category from this list: automation-heavy, web dev, data, design, sales, other.\\n\\nReturn ONLY a valid JSON array. Each object must contain person_id and category. Do not include markdown, explanations, or extra text.\\n\\nPeople:\\n{{ $input.all().map(item => `person_id: ${item.json.person_id}, name: ${item.json.full_name}, skills: ${item.json.skill_source_text}`).join('\\\\n') }}\"\n    }\n  ]\n}",
