    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n\n  const data = item.json;\n\n  // AI category Edit Fields se aa rahi hai\n  let categoryText =\n    data.skill_category ??\n    data.choices?.[0]?.message?.content ??\n    data.message?.content ??\n    data.content ??\n    '';\n\n  categoryText = String(categoryText)\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .replace(/[\"']/g, '')\n    .trim()\n    .toLowerCase();\n\n  let skill_category = 'other';\n\n  if (categoryText.includes('automation')) {\n    skill_category = 'automation-heavy';\n  }\n  else if (\n    categoryText.includes('web dev') ||\n    categoryText.includes('software developer') ||\n    categoryText.includes('software development') ||\n    categoryText.includes('web development')\n  ) {\n    skill_category = 'web dev';\n  }\n  else if (categoryText.includes('data')) {\n    skill_category = 'data';\n  }\n  else if (categoryText.includes('design')) {\n    skill_category = 'design';\n  }\n  else if (categoryText.includes('sales')) {\n    skill_category = 'sales';\n  }\n\n  return {\n    json: {\n      person_id: data.person_id,\n      skill_category: skill_category\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
